# ─── Servidor ───
PORT=3333
NODE_ENV=development
LOG_LEVEL=info
# Origem(ns) permitidas no CORS, separadas por vírgula. Produção: URL da Vercel.
FRONTEND_URL=http://localhost:3000

# ─── Banco ───
# Local (docker compose). Com a API no contêiner, o compose troca "localhost" por "db" sozinho.
# Produção (Supabase → Project Settings → Database → Connection string):
#   DATABASE_URL = pooler "Transaction" (porta 6543) + ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = conexão "Session"/direta (porta 5432), usada só nas migrations
DATABASE_URL=postgresql://chamados:chamados@localhost:5432/chamados
DIRECT_URL=postgresql://chamados:chamados@localhost:5432/chamados

# ─── Clerk ─── (passo a passo em docs/clerk-setup.md)
# Em desenvolvimento pode ficar vazio até criar a aplicação; em produção é obrigatório.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ─── Storage de anexos ───
# supabase = Supabase Storage (padrão). Um projeto só: bucket "anexos" em produção, "anexos-dev" em desenvolvimento.
# s3       = AWS S3 ou Cloudflare R2, para migrar no futuro se sair mais barato (docs/storage.md)
# Sem credenciais em dev a API sobe normalmente; só o upload falha.
STORAGE_DRIVER=supabase
STORAGE_BUCKET=anexos-dev
STORAGE_SIGNED_URL_TTL=600

# Driver supabase (Project Settings → API). A service role key NUNCA vai para o front.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Driver s3. AWS: deixe S3_ENDPOINT vazio. R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com e S3_REGION=auto.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ─── Seed ───
# E-mail do primeiro ADMIN. Ao entrar com esse e-mail no Clerk, a API vincula a conta.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NOME=Administradora
