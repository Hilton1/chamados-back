// Modelo de dados — Plataforma de Chamados de Condomínio (backend)
// Prisma 6. Em produção (Supabase): DATABASE_URL = pooler (porta 6543, ?pgbouncer=true),
// DIRECT_URL = conexão direta (porta 5432), usada pelas migrations.
//
// Regras que o Prisma não expressa (estão em SQL na migration inicial):
//   - avaliacoes.nota entre 1 e 5; propostas.valor > 0; propostas.tempo_execucao_horas > 0
//   - anexos.tamanho_bytes <= 5 MB
//   - tipo de arquivo por tipo de anexo (anexos_mime_por_tipo_chk):
//       ABERTURA    → JPG/PNG              (fotos de quem abriu)
//       COMPROVACAO → JPG/PNG/PDF          (prestador aprovado comprova o serviço)
//       FORMULARIO  → PDF/DOCX/XLSX        (quem abriu anexa para o prestador preencher)
//       PROPOSTA    → JPG/PNG/PDF/DOCX/XLSX (prestador devolve o formulário preenchido junto da proposta)
//   - anexo PROPOSTA exige proposta_id; os demais tipos não podem ter (anexos_proposta_chk)
//   - no máximo 1 proposta TRANSFERIDA/ACEITA por chamado (índice único parcial)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────── Enums ─────────

enum Perfil {
  ADMIN // administradora (acesso global)
  SINDICO
  FISCAL
  ZELADOR
  PRESTADOR
}

enum StatusPrestador {
  PENDENTE
  APROVADO
  BLOQUEADO
}

enum Urgencia {
  NORMAL // propostas abertas por até 48 h
  URGENTE // atendimento imediato
}

enum StatusChamado {
  ABERTO // recebendo propostas
  AGUARDANDO_APROVACAO // admin transferiu uma proposta; síndico decide
  EM_EXECUCAO // síndico aprovou; contato via WhatsApp
  CONCLUIDO
  CANCELADO
}

enum TipoAnexo {
  ABERTURA // fotos de quem abriu o chamado
  FORMULARIO // formulário anexado na abertura para o prestador preencher e devolver com a proposta
  PROPOSTA // arquivo enviado pelo prestador junto da proposta (ex.: formulário preenchido)
  COMPROVACAO // fotos/arquivos enviados por quem atendeu, para comprovar o serviço (opcional)
}

enum TipoEvento {
  ABERTO
  PROPOSTA_RECEBIDA
  TRANSFERIDA
  APROVADA
  REPROVADA // síndico reprovou a proposta transferida; chamado volta para ABERTO
  COMPROVACAO_ENVIADA
  CONCLUIDO
  CANCELADO
  AVALIADO
}

enum StatusProposta {
  ENVIADA
  TRANSFERIDA // transferida pela administradora ao síndico
  ACEITA // aprovada pelo síndico
  RECUSADA // reprovada pelo síndico ou recusada automaticamente quando outra foi aprovada
  CANCELADA // cancelada pelo prestador
}

// ───────── Tenancy / usuários ─────────

model Condominio {
  id        String   @id @default(uuid()) @db.Uuid
  nome      String
  cnpj      String?  @unique
  endereco  String
  bairro    String
  cidade    String
  uf        String   @db.Char(2)
  // Mapa do local. Preenchidas por geocodificação no cadastro (ou manualmente). Nulas = sem mapa.
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vinculos VinculoCondominio[]
  chamados Chamado[]

  @@map("condominios")
}

model Usuario {
  id          String   @id @default(uuid()) @db.Uuid
  clerkUserId String?  @unique @map("clerk_user_id") // null até o 1º login de quem foi pré-cadastrado
  nome        String
  email       String   @unique
  telefone    String?
  perfil      Perfil
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  vinculos              VinculoCondominio[]
  prestador             Prestador?          @relation("PrestadorUsuario")
  prestadoresAprov      Prestador[]         @relation("PrestadorAprovadoPor")
  chamadosCriados       Chamado[]           @relation("ChamadoCriadoPor")
  chamadosAprovados     Chamado[]           @relation("ChamadoAprovadoPor")
  propostasTransferidas Proposta[]          @relation("PropostaTransferidaPor")
  avaliacoes            Avaliacao[]
  anexosEnviados        Anexo[]
  eventos               ChamadoEvento[]

  @@map("usuarios")
}

// Escopo LGPD: SINDICO/FISCAL/ZELADOR só enxergam os condomínios vinculados. ADMIN não precisa de vínculo.
model VinculoCondominio {
  usuarioId    String @map("usuario_id") @db.Uuid
  condominioId String @map("condominio_id") @db.Uuid

  usuario    Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  condominio Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, condominioId])
  @@map("vinculos_condominio")
}

// ───────── Catálogo ─────────

model Categoria {
  id      String  @id @default(uuid()) @db.Uuid
  slug    String  @unique // eletrica, hidraulica, limpeza, infraestrutura, ti
  nome    String
  interna Boolean @default(false) // TI = uso interno da administradora
  ativa   Boolean @default(true)

  chamados    Chamado[]
  prestadores PrestadorCategoria[]

  @@map("categorias")
}

model Prestador {
  id               String          @id @default(uuid()) @db.Uuid
  usuarioId        String          @unique @map("usuario_id") @db.Uuid
  razaoSocial      String          @map("razao_social")
  documento        String          @unique // CNPJ ou CPF
  telefoneWhatsapp String          @map("telefone_whatsapp") // E.164, ex.: +5582999999999
  emiteNotaFiscal  Boolean         @map("emite_nota_fiscal")
  areaAtuacao      String          @map("area_atuacao")
  status           StatusPrestador @default(PENDENTE)
  aprovadoPorId    String?         @map("aprovado_por_id") @db.Uuid
  aprovadoEm       DateTime?       @map("aprovado_em")
  motivoBloqueio   String?         @map("motivo_bloqueio")
  // desnormalizados, atualizados na mesma transação que grava a avaliação
  mediaAvaliacao   Decimal         @default(0) @map("media_avaliacao") @db.Decimal(3, 2)
  totalAvaliacoes  Int             @default(0) @map("total_avaliacoes")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  usuario     Usuario              @relation("PrestadorUsuario", fields: [usuarioId], references: [id])
  aprovadoPor Usuario?             @relation("PrestadorAprovadoPor", fields: [aprovadoPorId], references: [id])
  categorias  PrestadorCategoria[]
  propostas   Proposta[]
  avaliacoes  Avaliacao[]

  @@index([status])
  @@map("prestadores")
}

model PrestadorCategoria {
  prestadorId String @map("prestador_id") @db.Uuid
  categoriaId String @map("categoria_id") @db.Uuid

  prestador Prestador @relation(fields: [prestadorId], references: [id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoriaId], references: [id])

  @@id([prestadorId, categoriaId])
  @@map("prestador_categorias")
}

// ───────── Chamados ─────────

model Chamado {
  id                 String        @id @default(uuid()) @db.Uuid
  numero             Int           @unique @default(autoincrement()) // protocolo legível
  condominioId       String        @map("condominio_id") @db.Uuid
  categoriaId        String        @map("categoria_id") @db.Uuid
  criadoPorId        String        @map("criado_por_id") @db.Uuid
  titulo             String
  descricao          String        @db.Text
  local              String // bloco/unidade/área comum
  urgencia           Urgencia      @default(NORMAL)
  status             StatusChamado @default(ABERTO)
  prazoPropostasAte  DateTime      @map("prazo_propostas_ate") // NORMAL: criação + 48h; URGENTE: definido na abertura
  aprovadoPorId      String?       @map("aprovado_por_id") @db.Uuid
  aprovadoEm         DateTime?     @map("aprovado_em")
  concluidoEm        DateTime?     @map("concluido_em")
  canceladoEm        DateTime?     @map("cancelado_em")
  motivoCancelamento String?       @map("motivo_cancelamento")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  condominio  Condominio      @relation(fields: [condominioId], references: [id])
  categoria   Categoria       @relation(fields: [categoriaId], references: [id])
  criadoPor   Usuario         @relation("ChamadoCriadoPor", fields: [criadoPorId], references: [id])
  aprovadoPor Usuario?        @relation("ChamadoAprovadoPor", fields: [aprovadoPorId], references: [id])
  anexos      Anexo[]
  eventos     ChamadoEvento[]
  propostas   Proposta[]
  avaliacao   Avaliacao?

  @@index([condominioId, status])
  @@index([categoriaId, status])
  @@index([status, urgencia, prazoPropostasAte])
  @@map("chamados")
}

model Anexo {
  id           String    @id @default(uuid()) @db.Uuid
  chamadoId    String    @map("chamado_id") @db.Uuid
  propostaId   String?   @map("proposta_id") @db.Uuid // só no tipo PROPOSTA
  tipo         TipoAnexo @default(ABERTURA)
  enviadoPorId String    @map("enviado_por_id") @db.Uuid
  nomeOriginal String    @map("nome_original")
  storagePath  String    @map("storage_path") // caminho no bucket privado do Supabase Storage
  mimeType     String    @map("mime_type") // tipos aceitos variam por `tipo` (ver topo do arquivo)
  tamanhoBytes Int       @map("tamanho_bytes")
  createdAt    DateTime  @default(now()) @map("created_at")

  chamado    Chamado   @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  proposta   Proposta? @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  enviadoPor Usuario   @relation(fields: [enviadoPorId], references: [id])

  @@index([chamadoId, tipo])
  @@index([propostaId])
  @@map("anexos")
}

// Linha do tempo do chamado. Gravada pelos services nas mesmas transações das mudanças de estado.
// `marco` = evento de destaque na tela (abertura, mínimo de propostas atingido, aprovação, reprovação, conclusão).
model ChamadoEvento {
  id        String     @id @default(uuid()) @db.Uuid
  chamadoId String     @map("chamado_id") @db.Uuid
  tipo      TipoEvento
  autorId   String?    @map("autor_id") @db.Uuid // null quando o autor é o sistema
  texto     String
  marco     Boolean    @default(false)
  createdAt DateTime   @default(now()) @map("created_at")

  chamado Chamado  @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  autor   Usuario? @relation(fields: [autorId], references: [id])

  @@index([chamadoId, createdAt])
  @@map("chamado_eventos")
}

model Proposta {
  id                 String         @id @default(uuid()) @db.Uuid
  chamadoId          String         @map("chamado_id") @db.Uuid
  prestadorId        String         @map("prestador_id") @db.Uuid
  valor              Decimal        @db.Decimal(12, 2)
  disponivelEm       DateTime       @map("disponivel_em") // data/hora em que o prestador consegue iniciar
  tempoExecucaoHoras Int            @map("tempo_execucao_horas")
  observacao         String?
  status             StatusProposta @default(ENVIADA)
  motivoRecusa       String?        @map("motivo_recusa") // preenchido quando o síndico reprova
  transferidaPorId   String?        @map("transferida_por_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  chamado        Chamado   @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  prestador      Prestador @relation(fields: [prestadorId], references: [id])
  anexos         Anexo[]
  transferidaPor Usuario?  @relation("PropostaTransferidaPor", fields: [transferidaPorId], references: [id])

  @@unique([chamadoId, prestadorId]) // 1 proposta ativa por prestador/chamado (editar em vez de reenviar)
  @@index([prestadorId])
  @@map("propostas")
}

// Nota geral única (1–5), dada por quem contratou (síndico ou admin em nome do condomínio).
model Avaliacao {
  id          String   @id @default(uuid()) @db.Uuid
  chamadoId   String   @unique @map("chamado_id") @db.Uuid
  prestadorId String   @map("prestador_id") @db.Uuid
  avaliadorId String   @map("avaliador_id") @db.Uuid
  nota        Int      @db.SmallInt
  comentario  String?
  createdAt   DateTime @default(now()) @map("created_at")

  chamado   Chamado   @relation(fields: [chamadoId], references: [id])
  prestador Prestador @relation(fields: [prestadorId], references: [id])
  avaliador Usuario   @relation(fields: [avaliadorId], references: [id])

  @@index([prestadorId])
  @@map("avaliacoes")
}
